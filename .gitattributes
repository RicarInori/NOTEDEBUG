# Line endings: this repo builds on Windows, macOS and Linux (DEV guide §0 platform matrix),
# so normalise text to LF and never let an editor's CRLF setting churn the diff.
* text=auto eol=lf

# Windows batch files must stay CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never touch these.
*.apk binary
*.jar binary
*.png binary
*.jpg binary
*.wasm binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary